{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper_content_manifest_v082.schema.json",
  "title": "V0.8.2 CANVAS paper content manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "paper", "overview", "sections", "assets", "terms", "references"],
  "properties": {
    "schema_version": {"const": "0.8.2"},
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title_en", "title_zh", "authors", "journal", "year", "doi", "pages"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "title_en": {"type": "string", "minLength": 1},
        "title_zh": {"type": "string", "minLength": 1},
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "affiliations": {"type": "array", "items": {"type": "string"}},
        "journal": {"type": "string", "minLength": 1},
        "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "doi": {"type": "string", "minLength": 1},
        "pages": {"type": "integer", "minimum": 1},
        "metadata": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {"label": {"type": "string"}, "value": {"type": "string"}}
          }
        }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qa", "story"],
      "properties": {
        "qa": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "answer"],
            "properties": {"question": {"type": "string"}, "answer": {"type": "string"}}
          }
        },
        "story": {"type": "string", "minLength": 1},
        "scope_note": {"type": "string"}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title_en", "title_zh", "blocks"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "title_en": {"type": "string", "minLength": 1},
          "title_zh": {"type": "string", "minLength": 1},
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/block"}
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/asset"}
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "definition_zh", "aliases"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "label": {"type": "string"},
          "definition_zh": {"type": "string"},
          "aliases": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9]+$"},
          "text": {"type": "string", "minLength": 1},
          "url": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "inline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string"},
        "citation_ids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]+$"}},
        "term_id": {"type": "string"},
        "figure_ids": {"type": "array", "items": {"type": "string"}},
        "section_id": {"type": "string"}
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "english", "chinese", "source_fragments"],
      "properties": {
        "type": {"const": "paragraph"},
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "english": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inline"}},
        "chinese": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inline"}},
        "source_fragments": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "tip": {"type": "string"},
        "term_note": {"type": "string"}
      }
    },
    "asset_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "asset_id"],
      "properties": {
        "type": {"const": "asset"},
        "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
      }
    },
    "block": {"oneOf": [{"$ref": "#/$defs/paragraph"}, {"$ref": "#/$defs/asset_ref"}]},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "group", "title_en", "title_zh", "intro", "caption_en", "caption_zh"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "kind": {"enum": ["figure", "table"]},
        "group": {"type": "string"},
        "title_en": {"type": "string"},
        "title_zh": {"type": "string"},
        "intro": {"type": "string"},
        "image_src": {"type": "string"},
        "caption_en": {"type": "string"},
        "caption_zh": {"type": "string"},
        "table": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": {"type": "array", "items": {"type": "string"}},
            "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
          }
        },
        "study": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "overview": {"type": "string"},
            "panels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "title", "explanation"],
                "properties": {
                  "label": {"type": "string"},
                  "title": {"type": "string"},
                  "explanation": {"type": "string"}
                }
              }
            },
            "conclusion": {"type": "string"},
            "boundary": {"type": "string"}
          }
        }
      }
    }
  }
}
